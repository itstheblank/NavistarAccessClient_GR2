<?xml version="1.0" encoding="utf-8"?>
<!--
  Không sao lưu dữ liệu sinh trắc học (vector khuôn mặt)
  lên Google Drive / sang thiết bị khác. (Áp dụng Android 12+)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="registered_faces.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="registered_faces.json" />
    </device-transfer>
</data-extraction-rules>
